FROM golang:1.25 AS build
WORKDIR /build
COPY functions/from-discogs/go.mod functions/from-discogs/go.sum ./
RUN go mod download
COPY functions/from-discogs/*.go ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /from-discogs

FROM alpine:3.19
COPY --from=build /from-discogs /app/from-discogs
# SQS-first long-running loop is built into the binary (runK3sLoop). When
# SQS_QUEUE_URL or MIN_INTERVAL is set, the binary stays running, polls SQS
# for new SNS-delivered submissions, and falls back to cursor sweep on empty
# queue. Same pattern as k3s_runner.py used by from-youtube/to-spotify.
CMD ["/app/from-discogs"]
